# Docker Compose only. Native backend uses server/.env instead.
# Generate random hex: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
WEB_ORIGIN=http://localhost:8080
# Keep empty until the BOM, wiring and safe operating limits are accepted.
HARDWARE_ACTUATION_ALLOWLIST=
